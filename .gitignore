# Локальные пусковые скрипты с путями конкретной машины
deploy-*.bat

# --- секреты и локальные данные: в репозиторий не попадают ---
# Токен Telegram-бота и id чата. Если такой файл один раз уйдёт в историю, токен придётся
# отзывать - удаления следующим коммитом недостаточно, он остаётся в объектах git.
print-watchdog/telegram_config.json

# Журнал наблюдения и логи служб - растут бесконечно и машине-специфичны
print-watchdog/events.json
print-watchdog/logs/

# Настройки конкретной установки: адреса принтеров, состав вентиляторов, блок monitoring.
# В репозитории вместо него лежит settings.example.json.
src/settings.json

# --- мусор ---
__pycache__/
*.py[cod]
*.bak
